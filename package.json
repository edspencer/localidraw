{
  "name": "localidraw",
  "version": "0.1.0",
  "description": "A local Excalidraw for the .excalidraw files in a folder: projects and canvases in a sidebar, autosave to disk, and live merge of edits made by your coding agent.",
  "keywords": [
    "excalidraw",
    "diagrams",
    "whiteboard",
    "local-first",
    "ai-agents",
    "coding-agents",
    "claude-code"
  ],
  "homepage": "https://github.com/edspencer/localidraw#readme",
  "bugs": {
    "url": "https://github.com/edspencer/localidraw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edspencer/localidraw.git"
  },
  "license": "MIT",
  "author": "Ed Spencer",
  "type": "module",
  "bin": {
    "localidraw": "dist/server/cli.js"
  },
  "files": [
    "dist/server/",
    "dist/web/",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "node scripts/build-web.mjs",
    "build:server": "node -e \"fs.rmSync('dist/server',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepack": "npm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@excalidraw/excalidraw": "0.18.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
